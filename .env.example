# Copy to .env and fill in. Never commit .env.

# ---- Local development (no Docker) ----
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/lingoprism

# ---- Docker (used by docker-compose.yml when deploying) ----
POSTGRES_DB=lingoprism
POSTGRES_USER=lingoprism
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Comma separated OAuth client IDs (web, android, ios) accepted for Google login
GOOGLE_CLIENT_IDS=

# AI dialogue from a photo (console.anthropic.com → API keys). Empty = feature off
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
# AI_TALK_MODEL=claude-opus-5-5

# Push notifications: path (inside the container) to the Firebase service-account JSON. Empty = off
FIREBASE_CREDENTIALS_FILE=

# Email (forgot password). Console backend prints emails to the backend log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Production (docker-compose.prod.yml) – see SECURITY.md ----
# DJANGO_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"  (the server refuses to start without one)
# DJANGO_ALLOWED_HOSTS=lingoprism.id.vn,www.lingoprism.id.vn
# CORS_ALLOWED_ORIGINS=https://lingoprism.id.vn,https://www.lingoprism.id.vn
# CSRF_TRUSTED_ORIGINS=https://lingoprism.id.vn,https://www.lingoprism.id.vn
# NUM_PROXIES=1                      # nginx in front (Cloudflare + nginx: keep 1, nginx restores the real IP)
# SECURE_HSTS_SECONDS=31536000       # only once HTTPS works everywhere
# API_DOCS=0                         # Swagger off in production
# DB_STATEMENT_TIMEOUT_MS=15000
# Rate limits (defaults in BE/config/settings/base.py), e.g. THROTTLE_DETECT=30/min THROTTLE_LOGIN=40/min
# DJANGO_DEBUG=0
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # Gmail: EMAIL_HOST_USER=<gmail>, EMAIL_HOST_PASSWORD=<16-char App Password>
# Mobile release build: flutter build apk --dart-define=API_URL=https://lingoprism.id.vn
