erDiagram
  vocab_language {
    varchar code PK
    varchar name
    varchar tts_locale
  }
  vocab_topic {
    bigint id PK
    varchar slug UK
    varchar name_vi
    varchar audience
    bigint owner_id FK
    varchar visibility
  }
  vocab_word {
    bigint id PK
    varchar slug UK
    jsonb levels
    varchar yolo_label
    varchar part_of_speech
    smallint difficulty
  }
  vocab_topicword {
    bigint id PK
    bigint topic_id FK
    bigint word_id FK
    int order
  }
  vocab_wordtranslation {
    bigint id PK
    bigint word_id FK
    varchar language_id FK
    varchar text
    varchar ipa
    varchar pinyin
    varchar status
    varchar verified_method
  }
  vocab_examplesentence {
    bigint id PK
    bigint word_id FK
    varchar language_id FK
    varchar text
    varchar transliteration
    varchar translation_vi
    varchar source
    varchar status
  }
  learning_personalword {
    bigint id PK
    bigint user_id FK
    bigint word_id FK
    varchar language
    varchar status
    bigint topic_id FK
    smallint stage
    float fsrs_difficulty
    float fsrs_stability
    timestamptz due_at
  }
  learning_studysession {
    bigint id PK
    bigint user_id FK
    varchar kind
    bigint topic_id FK
    varchar scheduler
    smallint planned_count
    smallint completed_count
    int xp_earned
  }
  learning_reviewlog {
    bigint id PK
    bigint user_id FK
    bigint personal_word_id FK
    bigint session_id FK
    varchar question_type
    bool correct
    smallint rating
    int response_ms
    float elapsed_days
  }
  quizzes_question {
    bigint id PK
    varchar kind
    varchar language_id FK
    bigint topic_id FK
    bigint word_id FK
    text prompt
    jsonb options
    smallint difficulty
  }
  quizzes_exam {
    bigint id PK
    varchar title
    varchar language_id FK
    bigint topic_id FK
    smallint pass_percent
    bool is_published
  }
  quizzes_submission {
    bigint id PK
    bigint user_id FK
    bigint exam_id FK
    varchar status
    timestamptz submitted_at
    numeric score
    numeric max_score
  }
  accounts_user {
    bigint id PK
  }
